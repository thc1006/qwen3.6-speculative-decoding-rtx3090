    results/**                          v1 per-request JSON
    analysis/summary.csv
    analysis/summary_by_config.csv
    analysis/verbose_accounting.json
    v2_3090_followup/**/*.log           v2 raw llama-cli logs
    v2_3090_followup/results_v2.json
